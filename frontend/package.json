{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:gamedata": "tsx scripts/fetch-xivapi-data.ts",
    "check:design-system": "bash scripts/check-design-system.sh",
    "check:design-system:strict": "bash scripts/check-design-system.sh --strict",
    "check:bundle": "pnpm build && size-limit",
    "test:e2e": "playwright test",
    "test:contrast": "playwright test e2e/contrast.spec.ts",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:parity": "node scripts/token-parity.mjs scripts/__parity__/index.baseline.css src/styles/tokens.generated.css",
    "tokens:check": "node scripts/build-tokens.mjs && git diff --exit-code -- src/styles/tokens.generated.css",
    "dupes": "jscpd src",
    "deadcode": "knip"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "400 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.562.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jscpd": "^5.0.14",
    "jsdom": "^27.4.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.35.3",
    "size-limit": "^12.1.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
