{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "vite.config.ts",
    "eslint.config.js",
    "eslint-design-system-plugin.js",
    "scripts/*.{mjs,ts}",
    "e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "vitest": {
    "entry": [
      "src/**/*.{bench,test,test-d,spec,spec-d}.?(c|m)[jt]s?(x)",
      "scripts/**/*.test.mjs",
      "**/__mocks__/**/*.?(c|m)[jt]s?(x)",
      "!src/components/loot/loggingModel.enumeration.test.ts"
    ]
  },
  "ignore": [
    "src/gamedata/**",
    "src/styles/tokens.generated.css",
    "src/components/loot/loggingModel.enumeration.test.ts"
  ]
}
