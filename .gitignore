# IDE
.idea/
.vscode/
# NOTE: `**/.claude/*` ignores the CONTENTS of every .claude dir at any depth rather than the
# dirs themselves — git cannot re-include anything whose parent directory is excluded, so
# `.claude/` would make the negation below impossible.
**/.claude/*
# ...except shared project skills, which carry checked-in team conventions
!/.claude/skills/
# ...and the shared project config: settings (permissions + hooks), the hook
# scripts themselves, and the project agents. settings.local.json stays
# ignored (machine-local overrides).
!/.claude/settings.json
!/.claude/hooks/
!/.claude/agents/
.superpowers/
docs/superpowers/
*.swp
*.swo
*~
.DS_Store

